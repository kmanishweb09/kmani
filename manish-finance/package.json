{
  "name": "manish-finance",
  "version": "0.1.0",
  "private": true,
  "description": "Finance Desk: personal M&A deal terminal and sector intelligence workspace for kmanish.live/finance",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && playwright test",
    "verify:content": "node scripts/verify-content.mjs",
    "build": "node scripts/build.mjs",
    "package:handoff": "node scripts/package-handoff.mjs",
    "check:sources:live": "node scripts/check-sources-live.mjs",
    "evidence:worklist": "node scripts/evidence.mjs worklist",
    "evidence:retrieve": "node scripts/evidence.mjs retrieve"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "fast-xml-parser": "5.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "miniflare": "4.20260730.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "3.2.7"
  }
}
