# Finance Desk configuration. Copy values into the host's secure configuration; never commit real secrets.
# Kinds: [host] supplied by the host, [config] non-secret deployment config, [secret] server secret, [optional], [dev] local only.

# [host] D1 binding named DB is supplied by the existing site. Do not hardcode a database ID.

# [config] Trusted host account ID allowed private/admin access. Required for private features; absent = fail closed.
FINANCE_OWNER_USER_ID=

# [config] Public origin used for same-origin checks and links, e.g. https://kmanish.live
FINANCE_PUBLIC_ORIGIN=

# [optional] AI assistance. Default is off. Only "anthropic" is implemented.
FINANCE_AI_PROVIDER=none
# [optional] Explicit model ID verified against the provider's documentation (not assumed from the build tool's model).
FINANCE_AI_MODEL=
# [secret, optional] Provider API key. Server-side only; never exposed to the browser.
FINANCE_AI_API_KEY=
# [optional] Daily spending cap in USD (decimal). 0 or empty keeps paid AI disabled.
FINANCE_AI_DAILY_BUDGET=0
# [optional] Dated price table used to estimate cost (USD per million tokens) and the date you verified it.
FINANCE_AI_PRICE_INPUT_PER_MTOK=
FINANCE_AI_PRICE_OUTPUT_PER_MTOK=
FINANCE_AI_PRICE_DATE=
# [optional] Output-token ceiling per AI request (1000–32000, default 8000). Also the worst case reserved against the budget.
FINANCE_AI_MAX_OUTPUT_TOKENS=8000
# [optional] Maximum AI requests per day (Asia/Kolkata calendar), default 60.
FINANCE_AI_DAILY_REQUESTS=60

# [secret] Restricted credential for the maintenance endpoint (>= 32 random characters). Sent as Authorization: Bearer ...
FINANCE_JOB_SECRET=

# [config] Honest application name and real contact for SEC EDGAR fair access, e.g. "FinanceDesk/1.0 (owner@example.com)".
# Leave empty until a real contact is chosen; the SEC connector stays "Not configured" until then.
FINANCE_SEC_USER_AGENT=

# [optional] Expected scheduler interval in minutes (used to label the schedule as observed or stale). Default 360.
FINANCE_SCHEDULE_EXPECTED_MINUTES=360
